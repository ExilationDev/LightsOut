	<Regions>
		<Region name="idle-up-1" x="0"   y="0" width="16" height="32" />
		<Region name="idle-up-2" x="16"  y="0" width="16" height="32" />
		<Region name="idle-up-3" x="32"  y="0" width="16" height="32" />
		<Region name="idle-up-4" x="48"  y="0" width="16" height="32" />
		<Region name="idle-up-5" x="64"  y="0" width="16" height="32" />
